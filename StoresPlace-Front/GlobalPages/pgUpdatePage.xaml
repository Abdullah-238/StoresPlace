<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoresPlace_Front.GlobalPages.pgUpdatePage"
             Title="pgInternetConnecation"
              NavigationPage.HasBackButton="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             xmlns:str="clr-namespace:StoresPlace_Front.Strings"
             >
    <VerticalStackLayout VerticalOptions="Center" Padding="24" Spacing="24">

        <Image Source="sensors_off" HeightRequest="128" WidthRequest="128"/>
        <Label Text="{x:Static str:AppStrings.Update_Version }" HorizontalTextAlignment="Center"  VerticalTextAlignment="Center" />

        <Button   Text="{x:Static str:AppStrings.Update }"
 Clicked="Button_Clicked"/>
    </VerticalStackLayout>
</ContentPage>