<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoresPlace_Front.Settings.MyStores.pgAddNewOffer"
              Title="{x:Static str:AppStrings.Please_enter_your_offer_details}"
              xmlns:str="clr-namespace:StoresPlace_Front.Strings"
              Shell.TabBarIsVisible="False"
              xmlns:Control="clr-namespace:StoresPlace_Front.Global.GlobalControl">

    <ScrollView>

        <VerticalStackLayout  Padding="24"  Spacing="24" >

            <Label Text="{x:Static str:AppStrings.Please_enter_your_offer_details}" />
            
            <Entry x:Name="enOffer"/>

            <Button Text="{x:Static str:AppStrings.Add_New_Offer }" x:Name="btAddNewOffer"   Clicked="btAddNewOffer_Clicked" />

            <ActivityIndicator x:Name="ctvActiveIndector1"  IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"  />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>