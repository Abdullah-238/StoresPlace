<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoresPlace_Front.Global.GlobalControl.ctvActiveIndector" 
             x:Name="This">
    
    

    
    
    <ActivityIndicator  IsRunning="{Binding IsRunning, FallbackValue='False'}"  TranslationY="-250" HeightRequest="50" WidthRequest="100"  Opacity="50"
                    Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                     />
    <!--BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"-->
    
</ContentView>
